{
  "name": "getmnemo-mastra",
  "version": "0.3.0",
  "description": "Mnemo memory provider for Mastra agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "smoke": "node scripts/prod-smoke.mjs"
  },
  "keywords": [
    "getmnemo",
    "mastra",
    "memory",
    "agent",
    "rag"
  ],
  "author": {
    "name": "Mnemo",
    "url": "https://mnemohq.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ledgermem/getmnemo-mastra.git"
  },
  "dependencies": {
    "getmnemo": "^0.6.0"
  },
  "peerDependencies": {
    "@mastra/core": ">=0.4.0"
  },
  "peerDependenciesMeta": {
    "@mastra/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "homepage": "https://mnemohq.com"
}
